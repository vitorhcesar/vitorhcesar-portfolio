# URL pública do site (canonical, Open Graph, sitemap e JSON-LD)
VITE_SITE_URL=https://vitorhcesar.dev

# Modo currículo: remove contato, redes sociais, currículo PDF e formulário (para Workana, etc.)
# Client (UI): VITE_CURRICULUM_MODE=true
# Server (API): CURRICULUM_MODE=true
# VITE_CURRICULUM_MODE=false
# CURRICULUM_MODE=false

# Opcional: e-mail de contato (exibido na seção Contato e no JSON-LD)
# VITE_CONTACT_EMAIL=contato@seudominio.com

# Opcional: WhatsApp (somente números com DDI+DDD, ex.: 5521999999999).
# Quando preenchido, o formulário pede apenas o nome e abre uma conversa pelo WhatsApp.
# VITE_WHATSAPP_NUMBER=5521999999999

# Opcional: perfil LinkedIn (adicionado ao JSON-LD sameAs)
# VITE_LINKEDIN_URL=https://linkedin.com/in/seu-perfil

# SMTP (server-only — never prefix with VITE_)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
SMTP_FROM=you@example.com
SMTP_SECURE=true

# Inbox that receives portfolio contact form messages
CONTACT_TO_EMAIL=you@example.com
